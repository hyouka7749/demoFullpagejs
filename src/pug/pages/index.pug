doctype html
html(lang="vi")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title FullPage Demo
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/fullPage.js/4.0.20/fullpage.min.css")
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css")
    link(rel='stylesheet', href='css/main.css')
    link(rel="icon", type="image/x-icon",sizes="32x32", href="/assets/images/pen.ico")
    link(rel="preconnect", href="https://fonts.googleapis.com")
    link(rel="preconnect", href="https://fonts.gstatic.com", crossorigin)
    link(href="https://fonts.googleapis.com/css2?family=Agu+Display&family=Honk&display=swap", rel="stylesheet")
  body
    #loading
      .spinner

    header.header
      a.logo(href="#home")
        span.logo-demo NATURE
        span.logo-front SHIELD
      nav
        ul
          li
            a.fa-solid.fa-house.nav-link.active(href="#home") 
          li
            a.fa-solid.fa-magnifying-glass.nav-link(href="#about")
          li
            a.fa-solid.fa-hand-holding-heart.nav-link(href="#portfolio")
          li
            a.fa-solid.fa-gear.nav-link(href="#services") 
          li 
            a.fa-solid.fa-images.nav-link(href="#gallary") 
          li
            a.fa-solid.fa-paper-plane.nav-link(href="#contact")
      button.hamburger-icon(aria-label="Toggle menu", aria-expanded="false")
        i.fas.fa-bars

    #fullpage
      .section.hero(data-anchor="home")
        .hero-content#hero-section-content
          .slide(data-anchor="slide1-chinh")
            .hero-main-content
              h1.animate-text Welcome to Nature Shield
              a.fa-brands.fa-google(href="/pages01/index.html") 
              p.animate-text.center-text Google Search 
              a.fa-solid.fa-list-ol(href="/pages02/list.html")
              p.animate-text.center-text List Page
          .slide(data-anchor="slide2-tam-nhin")
            .slide-content-wrapper
              h1.animate-text.right-text Tầm Nhìn Xa Hơn
              p.animate-text-delay Nature Shield không chỉ dừng lại ở các hoạt động hiện tại mà còn hướng tới những giải pháp bền vững, ứng dụng công nghệ tiên tiến và mở rộng hợp tác quốc tế để nhân rộng mô hình bảo tồn hiệu quả.
              img.slide-image.animate-text-delay(src="https://images.pexels.com/photos/29352966/pexels-photo-29352966/free-photo-of-c-nh-d-p-c-a-b-n-c-ng-lang-ven-bi-n-y.jpeg", alt="Tầm nhìn xa hơn")
              p.animate-text-delay Nature Shield không chỉ dừng lại ở các hoạt động hiện tại mà còn hướng tới những giải pháp bền vững, ứng dụng công nghệ tiên tiến và mở rộng hợp tác quốc tế để nhân rộng mô hình bảo tồn hiệu quả.

              img.slide-image.animate-text-delay(src="https://images.pexels.com/photos/459203/pexels-photo-459203.jpeg", alt="Tầm nhìn xa hơn")
          .slide(data-anchor="slide3-keu-goi")
            .slide-content-wrapper
              h1.animate-text Chung Tay Vì Hành Tinh Xanh!
              p.animate-text-delay Mỗi đóng góp, dù nhỏ bé, đều tạo nên sức mạnh to lớn. Hãy cùng Nature Shield lan tỏa tình yêu và trách nhiệm với thiên nhiên, kiến tạo một tương lai bền vững cho tất cả.
              a.button.hero-cta.animate-text-delay(href="#contact") Tham Gia Cùng Chúng Tôi
  
      .section#about-section(data-anchor="about")
      .section#portfolio-section(data-anchor="portfolio")
      .section#services-section(data-anchor="services")
      .section#gallary-section(data-anchor="gallary")
      .section#contact-section(data-anchor="contact")
        .section-content-wrapper
          div.contact-content
            h2 Liên Hệ Với Chúng Tôi
            p.contact-subtitle Hãy để lại thông tin, chúng tôi sẽ liên hệ với bạn sớm nhất
            .contact-grid
              .contact-info
                .contact-info-item
                  i.fas.fa-map-marker-alt
                  div
                    h3 Địa chỉ
                    p 123 Đường Xanh, Quận 1, TP.HCM
                .contact-info-item
                  i.fas.fa-envelope
                  div
                    h3 Email
                    p info@greenearth.org
                .contact-info-item
                  i.fas.fa-phone
                  div
                    h3 Điện thoại
                    p (84) 123 456 789
                .social-links
                  h3 Kết nối với chúng tôi
                  .social-icons
                    a.social-icon(href="#", aria-label="Facebook")
                      i.fab.fa-facebook-f
                    a.social-icon(href="#", aria-label="Google")
                      i.fab.fa-google
                    a.social-icon(href="#", aria-label="LinkedIn")
                      i.fab.fa-linkedin-in
              .contact-form
                h3 Gửi Tin Nhắn
                form(action="#", method="POST")
                  .form-row
                    .form-group
                      label(for="name") Họ và tên
                      input#name(type="text", name="name", placeholder="Nhập họ và tên", required)
                    .form-group
                      label(for="subject") Chủ đề
                      input#subject(type="text", name="subject", placeholder="Nhập chủ đề", required)
                  .form-group
                    label(for="message") Nội dung tin nhắn
                    textarea#message(name="message", placeholder="Nhập nội dung tin nhắn", required)
                  button(type="submit")
                    span Gửi Tin Nhắn
                    i.fas.fa-paper-plane
    footer#footer.site-footer
      .footer-content
        p © 2025 Demo Front.
        .social-icons
          a.social-icon(href="#", aria-label="Facebook")
            i.fab.fa-facebook-f
          a.social-icon(href="#", aria-label="Google")
            i.fab.fa-google
          a.social-icon(href="#", aria-label="LinkedIn")
            i.fab.fa-linkedin-in
            
    #image-lightbox.lightbox
      span.lightbox-close ×
      img.lightbox-content#lightbox-img(src="#", alt="Hình ảnh phóng to")
      #lightbox-caption.lightbox-caption

    script(src="https://cdnjs.cloudflare.com/ajax/libs/fullPage.js/4.0.20/fullpage.min.js")
    script(src="https://www.youtube.com/iframe_api") 
    script(src="js/main.js")
